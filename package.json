{
  "name": "iceage-animals",
  "version": "0.1.0",
  "description": "Ice Age Animals: a Minecraft Bedrock add-on and Java mod with woolly mammoths, sabre-toothed cats, giant ground sloths and other Ice Age animals at their real size",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "validate": "node tools/validate.mjs",
    "package": "node tools/package.mjs",
    "preview": "node tools/preview.mjs",
    "all": "npm run build && npm run validate && npm run package",
    "site": "node tools/site.mjs",
    "test:server": "tools/bds-test.sh",
    "lineup": "node tools/lineup.mjs",
    "check-hunting": "node tools/check-hunting.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@minecraft/server": "^2.0.0",
    "@minecraft/server-ui": "^2.0.0",
    "fflate": "^0.8.2",
    "pngjs": "^7.0.0"
  }
}
